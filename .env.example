# Copier dans .env puis renseigner localement avec les valeurs actuelles.
# Ne jamais remplir ce modèle avec des secrets ni le charger directement.

# Variables utilisées par Docker Compose
AIRFLOW_UID=
AIRFLOW_PROJ_DIR=.
_PIP_ADDITIONAL_REQUIREMENTS=
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Airflow : valeurs effectives à préserver.
# FERNET_KEY est actuellement vide dans la configuration effective.
FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
AIRFLOW__API__SECRET_KEY=
_AIRFLOW_WWW_USER_USERNAME=
_AIRFLOW_WWW_USER_PASSWORD=

# PostgreSQL de métadonnées Airflow (service Compose)
AIRFLOW_DB_NAME=
AIRFLOW_DB_USER=
AIRFLOW_DB_PASSWORD=
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=
AIRFLOW__CELERY__RESULT_BACKEND=

# PostgreSQL du Data Warehouse (distinct de la base Airflow)
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# SILO/MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# Conservées pour compatibilité locale; non utilisées par Compose actuellement.
AIRFLOW_IMAGE_NAME=
AIRFLOW_API_SERVER_PORT=
